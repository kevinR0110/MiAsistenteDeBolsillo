<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiAsistenteDeBolsillo.Views.DineroPage"
             Title="Dinero"
             BackgroundColor="#FFFBEB">

    <!-- Estilos reutilizables para las tarjetas de moneda -->
    <ContentPage.Resources>
        <Style x:Key="EtiquetaMoneda" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#B45309" />
        </Style>

        <Style x:Key="TarjetaMoneda" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#B45309" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="14" />
                </Setter.Value>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Conversor de monedas"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="#78350F" HorizontalOptions="Center" />
            <Label Text="HNL · USD · EUR"
                   FontSize="14" TextColor="#B45309" HorizontalOptions="Center" />

            <Entry x:Name="txtMonto"
                   Placeholder="Monto a convertir"
                   Keyboard="Numeric"
                   TextColor="#78350F" PlaceholderColor="#6B7280" />

            <!-- Texto de ayuda para que el usuario sepa qué hacer -->
            <Label Text="Toca cada recuadro para ver las monedas disponibles y elegir una."
                   FontSize="13" TextColor="#92400E" HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Tarjeta: moneda de origen -->
            <VerticalStackLayout Spacing="4">
                <Label Text="CONVERTIR DE" Style="{StaticResource EtiquetaMoneda}" />
                <Border Style="{StaticResource TarjetaMoneda}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Picker x:Name="pckOrigen"
                                Title="Toca para elegir la moneda"
                                TextColor="#78350F" TitleColor="#6B7280" />
                        <!-- InputTransparent: el toque pasa al Picker de abajo -->
                        <Label Grid.Column="1" Text="▼" FontSize="14"
                               TextColor="#B45309" VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Mejora C: botón circular que intercambia origen y destino -->
            <Button x:Name="btnIntercambiar"
                    Text="⇅" FontSize="22"
                    WidthRequest="48" HeightRequest="48" CornerRadius="24" Padding="0"
                    BackgroundColor="#FDE68A" TextColor="#78350F"
                    HorizontalOptions="Center"
                    Clicked="OnIntercambiarClicked" />

            <!-- Tarjeta: moneda de destino -->
            <VerticalStackLayout Spacing="4">
                <Label Text="CONVERTIR A" Style="{StaticResource EtiquetaMoneda}" />
                <Border Style="{StaticResource TarjetaMoneda}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Picker x:Name="pckDestino"
                                Title="Toca para elegir la moneda"
                                TextColor="#78350F" TitleColor="#6B7280" />
                        <Label Grid.Column="1" Text="▼" FontSize="14"
                               TextColor="#B45309" VerticalOptions="Center"
                               InputTransparent="True" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Botones: Convertir y Limpiar (mejora B) -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button x:Name="btnConvertir" Grid.Column="0"
                        Text="Convertir"
                        BackgroundColor="#B45309" TextColor="White"
                        Clicked="OnConvertirClicked" />
                <Button x:Name="btnLimpiar" Grid.Column="1"
                        Text="Limpiar"
                        BackgroundColor="#CBD5E1" TextColor="#78350F"
                        Clicked="OnLimpiarClicked" />
            </Grid>

            <Border x:Name="brdResultado" IsVisible="False"
                    Padding="20" StrokeThickness="0"
                    BackgroundColor="#B45309">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="lblDetalle" TextColor="White"
                           HorizontalOptions="Center" />
                    <Label x:Name="lblResultado" FontSize="40" FontAttributes="Bold"
                           TextColor="White" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>