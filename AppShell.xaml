<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MiAsistenteDeBolsillo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MiAsistenteDeBolsillo.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="#0F766E"
    Shell.TabBarTitleColor="White"
    Shell.TabBarUnselectedColor="#99F6E4"
    Title="Mi Asistente de Bolsillo">

    <TabBar>
        <ShellContent Title="Salud"
                      ContentTemplate="{DataTemplate views:SaludPage}"
                      Route="SaludPage" />
        <ShellContent Title="Dinero"
                      ContentTemplate="{DataTemplate views:DineroPage}"
                      Route="DineroPage" />
    </TabBar>
</Shell>